:80 {
    log

    # 1. Match deep subdomains (2+ levels, e.g., sub.sub.BASE_DOMAIN)
    # This looks for at least two dots before the BASE_DOMAIN
    @deep_subdomains header_regexp host Host `^([^.]+\.){2,}BASE_DOMAIN_RE$`

    handle @deep_subdomains {
        # No CORS headers here: these responses come from the tunneled user apps,
        # which decide about CORS themselves.
        reverse_proxy localhost:8080
    }

    # 2. Match base domain and first-level subdomains only (e.g., BASE_DOMAIN or sub.BASE_DOMAIN)
    # This ensures we capture both, but exclude the deep subdomains handled above
    @base_and_first_level host BASE_DOMAIN *.BASE_DOMAIN

    handle @base_and_first_level {
        # CORS for the frontend (incl. /_app/* assets) and the API, both of which
        # are accessed cross-subdomain from user spaces.
        # Only allow origins that are the base domain or any subdomain thereof.
        @subdomain_origin header_regexp origin Origin `^https?://([^.]+\.)*BASE_DOMAIN_RE$`
        header @subdomain_origin {
            Access-Control-Allow-Origin "{http.request.header.Origin}"
            Access-Control-Allow-Methods "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Max-Age "86400"
            Vary Origin
            defer
        }

        # Answer preflights here instead of forwarding them to the backends
        @preflight {
            method OPTIONS
            header_regexp preflight_origin Origin `^https?://([^.]+\.)*BASE_DOMAIN_RE$`
        }

        handle @preflight {
            respond 204
        }

        # Inside here, route by path
        @api_oauth path /api* /oauth*

        handle @api_oauth {
            reverse_proxy localhost:8080
        }

        # Fallback for everything else on base/first-level
        handle {
            reverse_proxy localhost:3000
        }
    }

    # 3. Catch-all fallback (Optional, but good practice)
    handle {
        reverse_proxy localhost:3000
    }
}
